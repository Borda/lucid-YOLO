# Ignore rules for lucid-yolo, grouped by what produces the artifact.
#
# The upstream github/gitignore Python template was merged in and then sorted
# alphabetically at some point, which detached every explanatory comment from the
# pattern it explained and hoisted the lot into one block at the top of the file.
# The grouping below restores the association: patterns sit under the section that
# creates them, sorted within their section only. No rule was added or removed in
# that reorganization — `git check-ignore` answers exactly what it answered before.
#
# A commented-out pattern is one the upstream template ships commented out; it is
# kept in that state here and is NOT in effect. Reproduced rather than deleted so
# the template's own advice stays readable beside what this repository actually does.

# --- Python bytecode and C extensions -------------------------------------
*$py.class
*.py[codz]
*.so
__pycache__/

# --- Distribution and packaging -------------------------------------------
*.egg
*.egg-info/
*.manifest
*.spec
.eggs/
.installed.cfg
# PyBuilder
.pybuilder/
MANIFEST
build/
develop-eggs/
dist/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
share/python-wheels/
target/
var/
wheels/

# PyInstaller: usually written by a python script from a template before
# PyInstaller builds the exe, so as to inject date/other infos into it.
# (the *.manifest / *.spec entries above)

# --- Installer and PyPI ----------------------------------------------------
# PyPI configuration file
.pypirc
pip-delete-this-directory.txt
pip-log.txt

# --- Environments and interpreter managers ---------------------------------
# .python-version (upstream ships this commented out; left commented — no such
# file exists in this repository, which pins its interpreter in `make setup`)
.Python
.env
.envrc
.venv
ENV/
env.bak/
env/
venv.bak/
venv/

# --- Dependency locks ------------------------------------------------------
# The upstream template's advice for each of these is to COMMIT the lock file.
# This repository ignores uv.lock and leaves the rest commented out; the entries
# are kept side by side so the divergence is visible rather than implicit.
# Pipfile.lock
# pdm.lock
# pixi.lock
# poetry.lock
# poetry.toml
# pdm.toml — pdm recommends committing project-wide config while excluding .pdm-python
uv.lock

# --- Package managers that create their own trees --------------------------
# pdm — https://pdm-project.org/en/latest/usage/project/#working-with-version-control
.pdm-build/
.pdm-python
# pixi creates a virtual environment in .pixi, as venv does in .venv
.pixi
# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pdm-project/pdm
__pypackages__/

# --- Test, coverage and type-checker caches --------------------------------
*.cover
*.py.cover
.coverage
.coverage.*
.dmypy.json
.hypothesis/
.mypy_cache/
.nox/
.pytest_cache/
.pytype/
.ruff_cache/
.tox/
cover/
coverage.xml
dmypy.json
htmlcov/
nosetests.xml

# --- This project's own generated artifacts --------------------------------
# Generated synthetic test fixtures (WP-007, A26) — regenerated on demand, never committed
tests/fixtures/_generated/
lightning_logs/
results/

# --- Documentation builds --------------------------------------------------
# mkdocs writes site/; Sphinx writes docs/_build/
/site
docs/_build/

# --- Editors, IDEs and OS ---------------------------------------------------
# JetBrains: the maintained template is Global/JetBrains.gitignore; the nuclear
# option below ignores the whole folder.
.idea/
.junie/
# Visual Studio Code: the maintained template is Global/VisualStudioCode.gitignore.
# Uncomment to ignore the entire vscode folder.
# .vscode/
.DS_Store
.ropeproject
.spyderproject
.spyproject
# Temporary file for partial code execution
tempCodeRunnerFile.py

# --- AI coding artifacts ----------------------------------------------------
.claude/agent-memory/
.claude/state/
.developments/
.experiments/
.notes/
.plans/
.reports/
.temp/

# --- Caches -----------------------------------------------------------------
.cache
.webassets-cache

# --- Notebooks and REPLs ----------------------------------------------------
.ipynb_checkpoints
ipython_config.py
profile_default/

# --- Marimo -----------------------------------------------------------------
__marimo__/
marimo/_lsp/
marimo/_static/

# --- Web frameworks ---------------------------------------------------------
# Django
db.sqlite3
db.sqlite3-journal
local_settings.py
# Flask
instance/
# Scrapy
.scrapy
# Streamlit
.streamlit/secrets.toml

# --- Task queues and brokers ------------------------------------------------
# Celery
celerybeat-schedule
celerybeat.pid
# ActiveMQ
activemq-data/
# RabbitMQ
mnesia/
rabbitmq-data/
rabbitmq/
# Redis
*.aof
*.rdb
*.pid

# --- Translations -----------------------------------------------------------
*.mo
*.pot

# --- Miscellaneous ----------------------------------------------------------
# Abstra — AI-powered process automation framework; learn more at https://abstra.io/docs
# Ignores directories containing user credentials, local state, and settings.
.abstra/
*.log
# Cython debug symbols
cython_debug/
# Pyre type checker
.pyre/
